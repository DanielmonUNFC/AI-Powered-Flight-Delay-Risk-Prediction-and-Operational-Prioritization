# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------

APP_NAME=Flight Delay Risk API
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# ------------------------------------------------------------------
# Databricks Connection
# ------------------------------------------------------------------

DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_ACCESS_TOKEN=

# ------------------------------------------------------------------
# Databricks Catalog
# ------------------------------------------------------------------

DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# ------------------------------------------------------------------
# Databricks Tables — Overview, Explorer & Prioritization endpoints
# ------------------------------------------------------------------

DATABRICKS_OVERVIEW_TABLE=flight_dashboard
DATABRICKS_EXPLORER_TABLE=flight_dashboard_explorer
DATABRICKS_AIRLINES_LOOKUP_TABLE=airlines_lookup
DATABRICKS_AIRPORTS_LOOKUP_TABLE=airports_lookup
DATABRICKS_PRIORITIZATION_RESULTS_TABLE=flight_prioritization_results
DATABRICKS_PRIORITIZATION_EVALUATION_TABLE=flight_prioritization_evaluation

# ------------------------------------------------------------------
# Databricks Tables — health check & upcoming endpoints
# ------------------------------------------------------------------

DATABRICKS_CLEAN_TABLE=flights_clean
DATABRICKS_PREDICTIONS_TABLE=flight_predictions
DATABRICKS_INSIGHTS_TABLE=flight_dashboard_insights
