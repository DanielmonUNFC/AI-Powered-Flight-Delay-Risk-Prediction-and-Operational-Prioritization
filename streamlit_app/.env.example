# ------------------------------------------------------------------
# FastAPI connection
# Streamlit reads data only through the API — no direct SQL access.
# ------------------------------------------------------------------

STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_API_OVERVIEW_PATH=/api/v1/overview
STREAMLIT_API_EXPLORER_PATH=/api/v1/explorer
STREAMLIT_API_PRIORITIZATION_PATH=/api/v1/prioritization
STREAMLIT_API_MODEL_INSIGHTS_PATH=/api/v1/model-insights
STREAMLIT_API_PREDICTION_PATH=/api/v1/predictions
STREAMLIT_API_EXPLORER_LIMIT=1000
STREAMLIT_API_PRIORITIZATION_LIMIT=500
STREAMLIT_API_TIMEOUT_SECONDS=30
